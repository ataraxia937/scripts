#!/bin/sh

format_output() {
  command -v "$1" >/dev/null || return
  shift
  printf "\n\033[96m==> Running %s:\033[0m\n" "$*"
  "$@"
  echo
}

format_output rustup rustup update

format_output cargo-install-update cargo install-update -a

if [ -e "$HOME/.local/bin/mise" ]; then
  format_output mise mise self-update -y
  mise ls > /tmp/mise-before.txt
  format_output mise mise upgrade && eval "$(mise hook-env)"
  mise ls > /tmp/mise-after.txt
  diff -u0 /tmp/mise-before.txt /tmp/mise-after.txt | sed '/^---/d; /^+++/d; /^@@/d'
fi

format_output pnpm pnpm update -g

format_output pip-audit pip-audit --fix

format_output gem gem update

format_output dotnet dotnet tool update -g --all

format_output go-global-update go-global-update

format_output flatpak flatpak update -y

if ! systemd-detect-virt -q && [ "$(fwupdmgr get-updates --json | jq -r '.Devices | length')" -gt 0 ]; then
  format_output fwupdmgr fwupdmgr update
fi

if [ "$SHELL" = "/bin/bash" ] && [ -f "$HOME/.local/share/blesh/ble.sh" ]; then
  format_output bash bash "$HOME/.local/share/blesh/ble.sh" --update
fi
